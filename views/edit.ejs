<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="bg-zinc-900 h-screen w-screen text-white p-10">
        <h1 class="text-3xl mb-5">Edit Post</h1>
        <form action="/update/<%= post._id%>" method="post">
            <textarea name="content" class="w-1/3 border-1 border-zinc-500 rounded-md py-5 block px-4 outline-none" ><%= post.content%></textarea>
            <input type="submit" value="Update Post" class="bg-yellow-500 rounded-md mt-5 cursor-pointer px-4 py-2">
        </form>
    </div>
    
</body>
</html>