<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Blog Spot</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="flex gap-12">
        <div class="bg-zinc-900 h-screen w-screen text-white py-10 px-20 ">
            <h1 class="text-3xl mb-5">Create User</h1>
            <form action="/register" method="post" class="flex flex-col w-1/3 gap-5">
                <input type="text" placeholder="name" name="name" class="outline-none px-2 py-1 border-zinc-500 border-2 rounded-md">
                <input type="text" placeholder="username" name="username" class="outline-none px-2 py-1 border-zinc-500 border-2 rounded-md">
                <input type="number" placeholder="age" name="age" class="outline-none px-2 py-1 border-zinc-500 border-2 rounded-md">
                <input type="email" placeholder="email" name="email" class="outline-none px-2 py-1 border-zinc-500 border-2 rounded-md">
                <input type="text" placeholder="password" name="password" class="outline-none px-2 py-1 border-zinc-500 border-2 rounded-md">
                <input type="submit" value="Create user" class="bg-blue-500 px-2 py-1 rounded-md">
            </form>
            
        </div>

        <div>
            <p class="text-9xl font-bold">BLOG SPOT</p>
        </div>

    </div>
    
</body>
</html>