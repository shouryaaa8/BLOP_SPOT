<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="bg-zinc-900 h-screen w-screen text-white p-10">
        <h1 class="text-3xl mb-5">Login User</h1>
        <form action="/login" method="post" class="flex gap-5">
            <input type="email" placeholder="email" name="email" class="outline-none px-2 py-1 border-zinc-500 border-2 rounded-md">
            <input type="text" placeholder="password" name="password" class="outline-none px-2 py-1 border-zinc-500 border-2 rounded-md">
            <input type="submit" value="Login" class="bg-blue-500 px-2 py-1 rounded-md">
        </form>
    </div>
    
</body>
</html>