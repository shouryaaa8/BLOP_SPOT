<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="bg-zinc-900">
    <div class="bg-zinc-900 h-fit w-screen text-white p-10">
        <form action="/post" method="post">
            <div class="flex justify-between">
                <div class="flex gap-2">
                    <div class="w-10 h-10 rounded-full overflow-hidden">
                        <img src="/images/uploads/<%= user.profilepic %>" class="w-full h-full object-cover" >

                    </div>
                    <h1 class="text-3xl">Hello, <%= user.name %></h1>

                </div>
                <a href="/logout" class="bg-red-700 rounded-md px-5 py-2">Logout</a>
            </div>
            <h1>you can create new posts here.</h1>
            <textarea name="content" class="py-2 px-5 mt-10 outline-none border-zinc-500 border-1 rounded-md w-1/3 block" placeholder="whats on your mind?"></textarea>
            <input type="submit" value="Create New Post" class="bg-blue-500 block mt-3 rounded-md px-4 py-2 cursor-pointer">
            <h1 class="mt-28">Your posts.</h1>
            <div class="postcontainer mt-5 flex flex-wrap gap-5">
                <% user.posts.forEach(function(post){ %>
                    <div class="w-1/3 h-fit bg-zinc-700 border-1 border-zinc-500 px-7 py-2 flex flex-col gap-2">
                        <h1 class="text-blue-400">@<%= user.username%></h1>
                        <h1><%= post.content%></h1>
                        
                        <div class="btns flex justify-between">
                            <a href="/like/<%= post._id %>" class="text-blue-400"><%= (post.likes.indexOf(user._id) === -1) ? "Like":"Unlike" %></a>
                            <a href="/edit/<%= post._id %>" class="text-zinc-400">Edit</a>
                        </div>
                    </div>
               <% })%>
            </div>

        </form>
    </div>
    
</body>
</html>